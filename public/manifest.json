{
  "manifest_version": 3,
  "name": "WhatsApp Image Rotator",
  "version": "1.0.0",
  "description": "Rotate images in the WhatsApp Web media viewer.",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
